{
  "name": "personal-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:js:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix .",
    "lint:css": "stylelint \"**/*.module.css\"",
    "lint:css:fix": "stylelint \"**/*.module.css\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,css,scss,md}": [
      "npm run lint",
      "npm run format:check"
    ]
  },
  "dependencies": {
    "@heroui/dropdown": "^2.3.29",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.4.1",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4",
    "classnames": "2.5.1",
    "framer-motion": "^12.23.26",
    "husky": "9.1.7",
    "next": "16.0.10",
    "next-intl": "4.5.8",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.1",
    "baseline-browser-mapping": "^2.10.8",
    "eslint": "9",
    "eslint-config-next": "16.0.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "jsdom": "^29.0.1",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "stylelint-config-css-modules": "4.5.1",
    "stylelint-config-recess-order": "7.4.0",
    "stylelint-config-standard": "39.0.1",
    "tailwindcss": "4",
    "typescript": "5.9.3",
    "vitest": "^4.1.1"
  }
}
